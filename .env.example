# ─────────────────────────────────────────────────────────────────────────────
# Harsha Firecracker — environment variables
# Copy this file to `.env.local` and fill in the values. NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# The public site URL (used for canonical URLs, sitemap, Open Graph).
# In production set this to your custom domain, e.g. https://harshafirecracker.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Lead form backend (pick ONE) ─────────────────────────────────────────────
# OPTION A — Formspree (easiest): create a free form at https://formspree.io,
# then paste your endpoint URL here. Looks like https://formspree.io/f/abcdwxyz
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# OPTION B — Google Apps Script → Google Sheet: deploy the script in
# README (section "Connect the lead form") as a Web App and paste its
# /exec URL here. If both are set, Formspree takes priority.
NEXT_PUBLIC_GOOGLE_SCRIPT_ENDPOINT=

# ── SEO ───────────────────────────────────────────────────────────────────────
# Google Search Console verification token (the content="..." value).
# Leave blank until you verify the domain in Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
